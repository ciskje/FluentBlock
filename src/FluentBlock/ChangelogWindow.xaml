<Window x:Class="FluentBlock.ChangelogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Changelog" Height="480" Width="560" MinWidth="420" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource AppFontFamily}">
  <DockPanel Margin="16">
    <TextBlock x:Name="ChangelogTitle" FontSize="15" FontWeight="SemiBold"
               TextWrapping="Wrap" DockPanel.Dock="Top" Margin="0,0,0,8"/>
    <Button Content="OK" Width="90" HorizontalAlignment="Right"
            DockPanel.Dock="Bottom" Margin="0,12,0,0" IsDefault="True" Click="OnOkClick"/>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <TextBlock x:Name="ChangelogBody" TextWrapping="Wrap"/>
    </ScrollViewer>
  </DockPanel>
</Window>
